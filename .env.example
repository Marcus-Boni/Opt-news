# Copie para .env. Nenhum valor real de tenant, segredo ou endpoint corporativo vai para o repositório.

# PostgreSQL local (docker compose up -d db)
DATABASE_URL=postgres://optnews:optnews@127.0.0.1:5433/optnews
# Banco de testes: o nome precisa terminar em _test; os testes recriam o schema a cada execução.
TEST_DATABASE_URL=postgres://optnews:optnews@127.0.0.1:5433/optnews_test

API_HOST=127.0.0.1
API_PORT=3001
# Origem do web em desenvolvimento (Vite). Usada no CORS de dev e nos cookies.
WEB_ORIGIN=http://localhost:5173

# dev = login simulado com personas sintéticas (recusado com NODE_ENV=production).
# entra = Microsoft Entra ID (OIDC) — ainda não implementado; depende de Q-04 (tenant/app registration).
AUTH_MODE=dev

# Curadoria automática (apps/api/src/intelligence). Coleta e avaliação rodam só no worker.
INGEST_CRON=*/15 * * * *
# Feeds sintéticos locais (npm run dev:fake-feeds). Hosts liberados para endereço privado: SÓ em desenvolvimento.
FAKE_FEEDS_BASE_URL=http://127.0.0.1:4020
INGEST_PRIVATE_HOSTS=127.0.0.1
# Só existe o provedor simulado até a aprovação de provedor e orçamento (Q-03): nenhuma chamada paga é possível.
# simulated (sem rede, sem custo) | foundry (ADR-0013: Entra via az login / identidade gerenciada, sem chave)
MODEL_PROVIDER=simulated
# Só com MODEL_PROVIDER=foundry: descomente e aponte para o recurso aprovado.
# FOUNDRY_ENDPOINT=https://<recurso>.cognitiveservices.azure.com
FOUNDRY_DEPLOYMENT=gpt-6-luna
MODEL_DAILY_CALL_LIMIT=500
# Modelo lê o texto do artigo para avaliar e escrever (nunca guardado nem exibido). Desligado até Q-02.
ARTICLE_READING=false
